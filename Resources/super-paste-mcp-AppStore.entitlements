<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The stdio MCP bridge (Contents/MacOS/super-paste-mcp) in the Mac App Store edition. MCP clients launch it
	     themselves, not Super Paste, so it is sandboxed on its own (not com.apple.security.inherit, which only works
	     for children of a sandboxed process) and only makes HTTP requests to the app's server on 127.0.0.1. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.network.client</key><true/>
</dict>
</plist>
